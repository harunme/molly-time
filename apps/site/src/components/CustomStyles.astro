---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: var(--molly-primary);
    --aw-color-primary-hover: var(--molly-primary-hover);
    --aw-color-primary-foreground: var(--molly-ink);
    --aw-color-primary-text: var(--molly-primary-text);
    --aw-color-focus: var(--molly-focus);
    --aw-color-link: var(--molly-ink);
    --aw-color-secondary: var(--molly-muted);
    --aw-color-accent: var(--aw-color-primary);

    --aw-color-text-heading: var(--molly-ink);
    --aw-color-text-default: var(--molly-ink);
    --aw-color-text-muted: var(--molly-muted);
    --aw-color-bg-page: var(--molly-ivory);

    --aw-color-bg-page-dark: var(--molly-night);

    ::selection {
      background-color: var(--aw-color-primary);
      color: var(--aw-color-primary-foreground);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: var(--molly-primary);
    --aw-color-primary-hover: var(--molly-primary-hover);
    --aw-color-primary-foreground: var(--molly-ink);
    --aw-color-primary-text: var(--molly-primary);
    --aw-color-focus: var(--molly-primary);
    --aw-color-link: var(--molly-ivory);
    --aw-color-secondary: var(--molly-night-muted);
    --aw-color-accent: var(--aw-color-primary);

    --aw-color-text-heading: var(--molly-ivory);
    --aw-color-text-default: #EAE5D9;
    --aw-color-text-muted: var(--molly-night-muted);
    --aw-color-bg-page: var(--molly-night);

    ::selection {
      background-color: var(--aw-color-primary);
      color: var(--aw-color-primary-foreground);
    }
  }
</style>
