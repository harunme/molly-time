---
import { SITE } from 'astrowind:config';
import logo from '~/assets/favicons/favicon.svg';
---

<span
  class="self-center inline-flex items-center gap-2.5 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <img src={logo.src} width="32" height="32" alt="" aria-hidden="true" class="h-8 w-8 shrink-0" />
  <span>{SITE?.name}</span>
</span>
