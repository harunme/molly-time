<script>
  const channels = {
    'com.molly.parent': { label: 'Android 家长端', filename: 'mollytime-android.apk', path: /^\/api\/client\/releases\/com\.molly\.parent\/\d+\/[a-f0-9]{64}\.apk$/ },
    'com.molly.tv': { label: '电视端', filename: 'mollytime-tv.apk', path: /^\/api\/client\/releases\/com\.molly\.tv\/\d+\/[a-f0-9]{64}\.apk$/ },
  };
  document.querySelectorAll<HTMLButtonElement>('[data-client-download]').forEach((button) => {
    button.addEventListener('click', async () => {
      const name = button.dataset.package as keyof typeof channels;
      const channel = channels[name];
      const status = document.getElementById(button.getAttribute('aria-describedby') || '');
      if (!channel || !status || button.disabled) return;
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.textContent = `正在获取${channel.label}安装包…`;
      try {
        const response = await fetch(`/api/client/releases/latest?packageName=${name}`, { signal: AbortSignal.timeout(12000), cache: 'no-store' });
        if (!response.ok) throw new Error('暂时无法获取安装包，请稍后重试。');
        const { release } = await response.json();
        if (!release) { status.textContent = `${channel.label}安装包尚未发布，请稍后再来。`; return; }
        if (release.packageName !== name || typeof release.url !== 'string' || typeof release.versionName !== 'string' || !Number.isSafeInteger(release.size) || release.size <= 0) throw new Error('安装包信息不完整，请稍后重试。');
        const url = new URL(release.url, location.origin);
        if (url.origin !== location.origin || !channel.path.test(url.pathname) || url.username || url.password || url.search || url.hash) throw new Error('安装包地址无效，请稍后重试。');
        const link = document.createElement('a');
        link.href = url.href;
        link.download = channel.filename;
        document.body.append(link); link.click(); link.remove();
        status.textContent = `${channel.label} v${release.versionName} · ${(release.size / 1024 / 1024).toFixed(1)} MB · 已开始下载`;
      } catch (error) {
        status.textContent = error instanceof Error && error.name !== 'TimeoutError' ? error.message : '网络连接超时，请重试。';
      } finally { button.disabled = false; button.removeAttribute('aria-busy'); }
    });
  });
</script>
