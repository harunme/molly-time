---
import Layout from '~/layouts/LandingLayout.astro';
import Image from '~/components/common/Image.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import DownloadButton from '~/components/landing/DownloadButton.astro';
import DownloadController from '~/components/landing/DownloadController.astro';
import DeviceShowcase from '~/components/landing/DeviceShowcase.astro';
const metadata = {
  title: 'MollyTime｜好内容，陪孩子长大', ignoreTitleTemplate: true,
  description: '故事、科普、英语，孩子看的内容由你来选。MollyTime 连接家长手机与孩子的电视，支持整理视频、安排观看时间与电视续播。',
};
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'MollyTime', url: 'https://mollytime.app/', inLanguage: 'zh-CN' }];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <section id="download" class="landing-hero">
    <div class="hero-copy">
      <h1 class="heading-1 hero-title">好内容，<br />陪孩子长大。</h1>
      <p class="body-3 hero-subtitle"><span>故事、科普、英语，</span><span>孩子看的内容由你来选。</span></p>
      <div class="download-actions">
        <DownloadButton id="download-android-button" />
        <DownloadButton id="download-button" channel="tv" secondary />
      </div>
    </div>
    <div class="story-garden" data-float aria-hidden="true">
      <Image src="~/assets/images/story-garden.png" alt="" widths={[480, 768, 1200, 1800]} sizes="(max-width: 767px) 100vw, 960px" format="webp" layout="none" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section id="features" class="feature-section section-space page-width">
    <div class="section-heading reveal"><h2 class="heading-3">手机选内容，电视看世界。</h2></div>
    <DeviceShowcase />
    <p class="product-note caption-2 muted">应用界面演示，视频由家长自行添加。</p>
  </section>

  <DownloadController />
</Layout>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const float = document.querySelector<HTMLElement>('[data-float]');
  if (float) {
    let visible = true;
    const update = () => { float.dataset.motion = visible && !document.hidden && !reduced.matches ? 'running' : 'paused'; };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }).observe(float);
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
    update();
  }
  if (!reduced.matches) {
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      (entry.target as HTMLElement).dataset.reveal = 'visible';
      observer.unobserve(entry.target);
    }), { rootMargin: '0px 0px -32px 0px' });
    document.querySelectorAll<HTMLElement>('.reveal').forEach(section => { if (section.getBoundingClientRect().top > innerHeight) section.dataset.reveal = 'waiting'; observer.observe(section); });
  }
  reduced.addEventListener('change', () => { if (reduced.matches) { document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(element => element.dataset.reveal = 'visible'); } });
</script>
