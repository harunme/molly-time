FROM node:22-slim AS frontend-build
WORKDIR /tv-web
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY apps/tv/web/package.json apps/tv/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/tv/web/index.html apps/tv/web/tsconfig.json apps/tv/web/vite.config.ts ./
COPY apps/tv/web/src ./src
RUN pnpm build

WORKDIR /web
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/index.html apps/web/tsconfig.json apps/web/vite.config.ts ./
COPY apps/web/src ./src
RUN pnpm build

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    MOLLYTIME_TV_WEB_DIR=/app/tv/web \
    MOLLYTIME_PARENT_WEB_DIR=/app/web \
    MOLLYTIME_ANDROID_BUILD_TOOLS_DIR=/usr/bin

# Uploads require actual codec validation and thumbnail extraction.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg aapt apksigner default-jre-headless \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/server/pyproject.toml /app/pyproject.toml
RUN python -c "import pathlib, subprocess, sys, tomllib; deps = tomllib.loads(pathlib.Path('pyproject.toml').read_text())['project']['dependencies']; subprocess.run([sys.executable, '-m', 'pip', 'install', *deps], check=True)"
COPY apps/server/mollytime_server /app/mollytime_server
COPY --from=frontend-build /tv-web/dist /app/tv/web
COPY --from=frontend-build /web/dist /app/web

EXPOSE 8096
CMD ["python", "-m", "mollytime_server.main"]
